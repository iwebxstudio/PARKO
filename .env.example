# ==============================================================================
# PARKO — Parking Management System
# Environment Variables Template (.env.example)
# Copy this file to .env or run directly with default values
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=parko
POSTGRES_PASSWORD=parko_secret_2024
POSTGRES_DB=parko_db
DATABASE_URL=postgresql://parko:parko_secret_2024@postgres:5432/parko_db?schema=public

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT Authentication (Minimum 16 characters required) ---
JWT_SECRET=parko-enterprise-secure-jwt-secret-key-32chars-min!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Backend Application ---
BACKEND_PORT=3000
NODE_ENV=production

# --- Host Port Mappings (Docker) ---
BACKEND_HOST_PORT=39743
POSTGRES_HOST_PORT=39744
REDIS_HOST_PORT=39745
PRINT_AGENT_PORT=39746

# --- Frontend Application ---
# Leave empty for automatic relative proxying
VITE_API_URL=
VITE_WS_URL=

# --- File Upload Configuration ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- Nginx Gateway Ports ---
PARKO_PORT=39741
PARKO_SSL_PORT=39742
