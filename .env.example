# ==============================================================================
# PARKO — ລະບົບຄຸ້ມຄອງລານຈອດລົດອັດສະລິຍະ (Parking Management System)
# ຟາຍແບບຢ່າງການຕັ້ງຄ່າສະພາບແວດລ້ອມລະບົບ (.env.example)
# ສຳເນົາຟາຍນີ້ໄປເປັນ .env ຫຼື ນຳໃຊ້ຄ່າເລີ່ມຕົ້ນນີ້ສຳລັບການຕິດຕັ້ງ ແລະ ທົດສອບລະບົບ
# ==============================================================================

# --- ການຕັ້ງຄ່າຖານຂໍ້ມູນ (PostgreSQL) ສຳລັບເກັບກຳຂໍ້ມູນຫຼັກທັງໝົດຂອງລະບົບ ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=parko
POSTGRES_PASSWORD=parko_secret_2024
POSTGRES_DB=parko_db
DATABASE_URL=postgresql://parko:parko_secret_2024@postgres:5432/parko_db?schema=public

# --- ການຕັ້ງຄ່າ Redis Cache ສຳລັບລະບົບ Rate Limiting, Session ແລະ Realtime Gateway ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- ລະບົບຄວາມປອດໄພ ແລະ ການຢືນຢັນຕົວຕົນ JWT (ຕ້ອງມີຄວາມຍາວຢ່າງໜ້ອຍ 16 ຕົວອັກສອນຂຶ້ນໄປ) ---
JWT_SECRET=parko-enterprise-secure-jwt-secret-key-32chars-min!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- ການຕັ້ງຄ່າແອັບພລິເຄຊັນ Backend (NestJS API Service) ---
BACKEND_PORT=3000
NODE_ENV=production

# --- ການກຳນົດພອດເຊື່ອມຕໍ່ລະຫວ່າງ Host Machine ແລະ Docker Containers ເພື່ອປ້ອງກັນພອດຊົນກັນ ---
BACKEND_HOST_PORT=39743
POSTGRES_HOST_PORT=39744
REDIS_HOST_PORT=39745
PRINT_AGENT_PORT=39746

# --- ການຕັ້ງຄ່າແອັບພລິເຄຊັນ Frontend (React SPA) ---
# ປະຫວ່າງໄວ້ເພື່ອໃຫ້ລະບົບ Nginx Reverse Proxy ສົ່ງຕໍ່ API ແລະ WebSocket ຜ່ານ Relative Path ແບບອັດຕະໂນມັດ
VITE_API_URL=
VITE_WS_URL=

# --- ການຕັ້ງຄ່າລະບົບອັບໂຫຼດຟາຍ ແລະ ຮູບພາບຍານພາຫະນະ (ກຳນົດຂະໜາດສູງສຸດ 5MB) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# --- ພອດເຊື່ອມຕໍ່ຫຼັກຂອງ Nginx Gateway (ຮອງຮັບທັງ HTTP ທຳມະດາ ແລະ HTTPS/SSL ທີ່ປອດໄພ) ---
PARKO_PORT=39741
PARKO_SSL_PORT=39742
