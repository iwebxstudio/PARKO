generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  username          String           @unique @db.VarChar(50)
  email             String           @unique @db.VarChar(255)
  passwordHash      String           @map("password_hash") @db.VarChar(255)
  displayName       String           @map("display_name") @db.VarChar(100)
  role              Role             @default(STAFF)
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  phoneNumber       String?          @unique @map("phone_number") @db.VarChar(20)
  auditLogs         AuditLog[]
  resolvedCases     LostTicketCase[] @relation("ResolvedBy")
  lostTicketCases   LostTicketCase[] @relation("HandledBy")
  checkedInTickets  ParkingTicket[]  @relation("CheckedInBy")
  checkedOutTickets ParkingTicket[]  @relation("CheckedOutBy")
  membershipsCreated Membership[]    @relation("MembershipCreatedBy")
  payments          Payment[]
  refreshTokens     RefreshToken[]
  settingsUpdated   SystemSetting[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model VehicleType {
  id           Int             @id @default(autoincrement())
  name         String          @unique @db.VarChar(50)
  label        String          @db.VarChar(100)
  icon         String          @db.VarChar(50)
  description  String?         @db.VarChar(255)
  isActive     Boolean         @default(true) @map("is_active")
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  tickets      ParkingTicket[]
  pricingRules PricingRule[]
  memberships  Membership[]

  @@map("vehicle_types")
}

model PricingRule {
  id            String      @id @default(uuid()) @db.Uuid
  vehicleTypeId Int         @map("vehicle_type_id")
  pricingType   ParkingType @map("pricing_type")
  basePrice     Decimal     @default(0) @map("base_price") @db.Decimal(12, 2)
  hourlyRate    Decimal     @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  dailyRate     Decimal     @default(0) @map("daily_rate") @db.Decimal(12, 2)
  weeklyRate    Decimal     @default(0) @map("weekly_rate") @db.Decimal(12, 2)
  monthlyRate   Decimal     @default(0) @map("monthly_rate") @db.Decimal(12, 2)
  yearlyRate    Decimal     @default(0) @map("yearly_rate") @db.Decimal(12, 2)
  freeMinutes   Int         @default(0) @map("free_minutes")
  isActive      Boolean     @default(true) @map("is_active")
  effectiveFrom DateTime?   @map("effective_from")
  effectiveTo   DateTime?   @map("effective_to")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  @@index([vehicleTypeId, isActive])
  @@map("pricing_rules")
}

model ParkingTicket {
  id             String          @id @default(uuid()) @db.Uuid
  ticketNumber   String          @unique @map("ticket_number") @db.VarChar(10)
  vehicleTypeId  Int             @map("vehicle_type_id")
  plateNumber    String?         @map("plate_number") @db.VarChar(20)
  plateLetters   String?         @map("plate_letters") @db.VarChar(10)
  plateProvince  String?         @map("plate_province") @db.VarChar(50)
  qrCodeData     String          @map("qr_code_data")
  status         TicketStatus    @default(ACTIVE)
  parkingType    ParkingType     @default(HOURLY) @map("parking_type")
  customStart    DateTime?       @map("custom_start")
  customEnd      DateTime?       @map("custom_end")
  prepaidAmount  Decimal?        @map("prepaid_amount") @db.Decimal(12, 2)
  checkInAt      DateTime        @default(now()) @map("check_in_at")
  checkOutAt     DateTime?       @map("check_out_at")
  totalAmount    Decimal?        @map("total_amount") @db.Decimal(12, 2)
  paymentStatus  PaymentStatus   @default(UNPAID) @map("payment_status")
  checkedInById  String          @map("checked_in_by") @db.Uuid
  checkedOutById String?         @map("checked_out_by") @db.Uuid
  membershipId   String?         @map("membership_id") @db.Uuid
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  lostTicket     LostTicketCase?
  checkedInBy    User            @relation("CheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy   User?           @relation("CheckedOutBy", fields: [checkedOutById], references: [id])
  vehicleType    VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  membership     Membership?     @relation(fields: [membershipId], references: [id])
  payments       Payment[]

  @@index([ticketNumber])
  @@index([plateNumber])
  @@index([status])
  @@index([checkInAt])
  @@index([checkOutAt])
  @@index([status, checkInAt])
  @@index([status, plateNumber])
  @@index([paymentStatus])
  @@index([membershipId])
  @@index([plateLetters])
  @@map("parking_tickets")
}

model LostTicketCase {
  id              String               @id @default(uuid()) @db.Uuid
  ticketId        String               @unique @map("ticket_id") @db.Uuid
  staffId         String               @map("staff_id") @db.Uuid
  vehiclePhotoUrl String?              @map("vehicle_photo_url")
  driverPhotoUrl  String?              @map("driver_photo_url")
  idCardPhotoUrl  String?              @map("id_card_photo_url")
  notes           String
  resolution      LostTicketResolution @default(PENDING)
  penaltyAmount   Decimal              @default(0) @map("penalty_amount") @db.Decimal(12, 2)
  resolvedAt      DateTime?            @map("resolved_at")
  resolvedById    String?              @map("resolved_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  resolvedBy      User?                @relation("ResolvedBy", fields: [resolvedById], references: [id])
  staff           User                 @relation("HandledBy", fields: [staffId], references: [id])
  ticket          ParkingTicket        @relation(fields: [ticketId], references: [id])

  @@index([resolution])
  @@map("lost_ticket_cases")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @map("ticket_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  receivedById    String        @map("received_by") @db.Uuid
  paidAt          DateTime      @default(now()) @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  receivedBy      User          @relation(fields: [receivedById], references: [id])
  ticket          ParkingTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([paidAt])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model NotificationConfig {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  config    Json
  isActive  Boolean             @default(false) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("notification_configs")
}

enum Role {
  ADMIN
  STAFF
}

enum TicketStatus {
  ACTIVE
  COMPLETED
  LOST
}

enum ParkingType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
  PENDING
}

enum PaymentMethod {
  CASH
  QR_PAYMENT
  TRANSFER
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  DISCORD
}

enum LostTicketResolution {
  PENDING
  RESOLVED
  ESCALATED
}

enum MemberType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum MemberStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Membership {
  id             String          @id @default(uuid()) @db.Uuid
  memberCode     String          @unique @map("member_code") @db.VarChar(20)
  plateNumber    String          @map("plate_number") @db.VarChar(20)
  plateProvince  String?         @map("plate_province") @db.VarChar(50)
  vehicleTypeId  Int             @map("vehicle_type_id")
  memberType     MemberType      @map("member_type")
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  paidAmount     Decimal         @default(0) @map("paid_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod   @default(CASH) @map("payment_method")
  status         MemberStatus    @default(ACTIVE)
  notes          String?
  createdById    String          @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  vehicleType    VehicleType     @relation(fields: [vehicleTypeId], references: [id])
  createdBy      User            @relation("MembershipCreatedBy", fields: [createdById], references: [id])
  tickets        ParkingTicket[]

  @@index([plateNumber])
  @@index([status])
  @@index([memberCode])
  @@index([endDate])
  @@index([plateNumber, status])
  @@map("memberships")
}
